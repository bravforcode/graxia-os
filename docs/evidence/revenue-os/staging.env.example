# Copy to the staging platform secret store; do not commit real values.
APP_ENV=staging
NO_LIVE_PAYMENT_MODE=true
KILL_SWITCH_ALL_EXTERNAL_BETA=true
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
CELERY_BROKER_URL=redis://<host>:6379/0
CELERY_RESULT_BACKEND=redis://<host>:6379/0
ADMIN_API_KEY=<staging-admin-key>
STRIPE_SECRET_KEY=sk_test_<staging-test-key>
STRIPE_WEBHOOK_SECRET=whsec_<staging-test-webhook-secret>
