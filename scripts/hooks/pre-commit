#!/bin/sh
set -e

# NOTE: package.json `prepare` runs `git config core.hooksPath scripts/hooks`,
# which makes THIS the only active git hook repo-wide. If the project later
# needs commit-msg / pre-push hooks, add them here (or switch to a hook
# manager) — they will not run from any other location.

# Case-collision guard — always runs (only needs git)
bash scripts/check-case-collision.sh

# Frontend lint — runs when a JS package manager is available.
# Does not hard-fail if bun/npm are absent from the hook's PATH
# (e.g. minimal shell environments); the developer can run lint manually.
cd frontend
if command -v bun >/dev/null 2>&1; then
  bun run lint
elif command -v npm >/dev/null 2>&1; then
  npm run lint
else
  echo "pre-commit: bun/npm not found in PATH; skipping lint check"
fi
