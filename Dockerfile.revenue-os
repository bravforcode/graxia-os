# Dockerfile.revenue-os — Revenue OS API + Celery worker/beat image
# Build:  docker build -f Dockerfile.revenue-os -t graxia-revenue-os:latest .
# Run:    docker compose -f docker-compose.revenue-os.yml up -d
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Root requirements cover the full revenue_os stack (fastapi, sqlalchemy async,
# asyncpg, celery, redis, structlog, python-telegram-bot, stripe, resend).
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY graxia/ graxia/
COPY scripts/ scripts/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/api/system/readiness || exit 1

# Default: API server. Override command for worker/beat (see compose file).
CMD ["uvicorn", "graxia.services.revenue_os_api.app:app", "--host", "0.0.0.0", "--port", "8000"]