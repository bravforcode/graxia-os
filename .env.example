# ──────────────────────────────────────────────────────────────────────────────
# Graxia Revenue OS — Environment Variables
# COPY THIS TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT .env TO VERSION CONTROL
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: Security Keys ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-min-64-chars
ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ── REQUIRED: Database ────────────────────────────────────────────────────────
# asyncpg driver required (postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/graxia_dev

# ── App Configuration ─────────────────────────────────────────────────────────
APP_ENV=development

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── Supabase (optional for local dev) ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here

# ── Telegram Alerts (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

# ──────────────────────────────────────────────────────────────────────────────
# AUTONOMOUS COMMERCE (Phase 1 + Phase 2) — env vars consumed by the agents
# ──────────────────────────────────────────────────────────────────────────────

# ── Admin API (REQUIRED before ANY autonomy leaves OFF) ─────────────────────
# Used by /api/autonomy/* and /api/policy/*. Generate: openssl rand -base64 32
# Production FAILS CLOSED if unset.
ADMIN_API_KEY=your-admin-api-key

# ── Stripe (payment + refunds) ────────────────────────────────────────────────
# LIVE keys start with sk_live_ / whsec_live_. The refund executor reads
# STRIPE_API_KEY or falls back to STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX
STRIPE_API_KEY=            # optional alias; leave blank to use STRIPE_SECRET_KEY

# ── Shopify channel (Phase 2) ─────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_XXXX
SHOPIFY_WEBHOOK_SECRET=your-random-webhook-secret

# ── POD / dropship supplier (Phase 2) ─────────────────────────────────────────
SUPPLIER_API_URL=https://api.printful.com
SUPPLIER_API_KEY=your-supplier-key
SUPPLIER_WEBHOOK_SECRET=your-random-webhook-secret

# ── Meta Ads (Phase 2) ────────────────────────────────────────────────────────
META_ACCESS_TOKEN=your-long-lived-token
META_AD_ACCOUNT_ID=act_XXXX

# ── Autonomy rollout ──────────────────────────────────────────────────────────
# Gate 0: after provisioning, run scripts/provision_autonomy_phase1.py
# Stages: off -> shadow -> limited -> full (see docs/runbooks/autonomy-rollout.md)

# ── Security Headers (production only) ────────────────────────────────────────
# SECURITY_HEADERS_CSP=default-src 'self';
# SECURITY_HEADERS_HSTS_MAX_AGE=63072000
# SECURITY_HEADERS_FRAME_OPTIONS=DENY

# ── Staging Configuration ─────────────────────────────────────────────────────
# APP_ENV=staging
# ENABLE_MOCK_AUTH=true
# STAGING_REQUIRE_AUTH=true
# LOCAL_DEV_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# ALLOWED_ORGANIZATION_IDS=
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# PUBLIC_RATE_LIMIT_REQUESTS_PER_MINUTE=20
# MCP_RATE_LIMIT_REQUESTS_PER_MINUTE=30
# STRIPE_MODE=test
# ALLOW_LIVE_STRIPE=false
# STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
# STRIPE_WEBHOOK_SECRET=whsec_test_PLACEHOLDER
# EMAIL_PROVIDER=mock
# ALLOW_REAL_EMAIL_SEND=false
# GOOGLE_WORKSPACE_PROVIDER=mock
# ALLOW_REAL_GOOGLE_MUTATION=false
# ALLOW_REAL_LLM_CALLS=false
# LOG_LEVEL=INFO
# STRUCTURED_LOGGING=true
